# .NET build artifacts
**/bin/
**/obj/
*.user

# Test results
**/TestResults/

# Lean build cache (can be huge — rebuild with `lake build`)
**/.lake/

# Local environment / secrets
.env

# Temporary Lean files created by AxiomChecker at runtime
**/_nexus_tmp/

# Docker build remnants
*.dockerignore.bak

# Runtime / IDE tooling
.fsde-runtime/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.idea/
*.suo
*.swp
.vscode/settings.json

# Large zip artifacts
*.zip

# Raw bench/A-B logs — writeups + bench *.json/*.meta.json are committed, logs are not
data/results/*.log
# Bench HTML reports generated alongside the JSONs (older tracked ones stay tracked)
data/results/*.html

# Agent session tooling
.zcode/

# Local notes
ToDoList/

# Training/eval telemetry byproducts (phase4 experiments)
NexusAgent/phase4_results/
